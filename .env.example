# Application
APP_NAME="Smart City IoT Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API
API_HOST="0.0.0.0"
API_PORT=8000
API_PREFIX="/api/v1"

# Database - PostgreSQL with TimescaleDB
DATABASE_URL="postgresql+asyncpg://smartcity:smartcity123@localhost:5432/smartcity_iot"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0

# InfluxDB
INFLUXDB_URL="http://localhost:8086"
INFLUXDB_TOKEN="your-super-secret-token"
INFLUXDB_ORG="smartcity"
INFLUXDB_BUCKET="iot_sensors"

# MQTT Broker
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883
MQTT_USERNAME="iot_platform"
MQTT_PASSWORD="mqtt_secure_pass"
MQTT_TOPIC_PREFIX="smartcity"
MQTT_QOS=1

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# JWT Authentication
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
ALLOWED_HOSTS="*"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
DEVICE_TOKEN_EXPIRE_DAYS=365

# External APIs
WEATHER_API_KEY="your-weather-api-key"
TRAFFIC_API_KEY="your-traffic-api-key"

# Alerting
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="alerts@smartcity.com"
SMTP_PASSWORD="your-email-password"
ALERT_EMAIL_FROM="alerts@smartcity.com"

# WebSocket
WS_HOST="0.0.0.0"
WS_PORT=8001

# Monitoring
PROMETHEUS_PORT=9090

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
UPLOAD_DIR="./uploads"

# OTA Updates
FIRMWARE_STORAGE_PATH="./firmware"
MAX_FIRMWARE_SIZE=52428800  # 50MB

# Machine Learning
ML_MODEL_PATH="./ml_models"
ENABLE_PREDICTIVE_ANALYTICS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
DEVICE_RATE_LIMIT_PER_MINUTE=1000
